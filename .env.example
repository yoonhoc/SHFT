# Copy to .env, fill in, and load it before running a step:
#   cp .env.example .env
#   set -a && source .env && set +a
# We called every hosted model through one LiteLLM proxy, so one key served all of them.
# Any OpenAI-compatible endpoint works for the OpenAI variables.
# GPT-6 Luna: golden step labels (build-dataset/golden_step/judge.py) and AutoRater (evaluate-agent/autorater, --rater-openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# GPT-6 Sol: SWE-QA-Pro judge (evaluate-agent/score/gpt_judge)
LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_API_KEY=
# Claude Sonnet 5.5 with Message Batches: SWE-QA judge (evaluate-agent/score/claude_judge).
# This judge also reads LITELLM_API_KEY, so without a proxy set LITELLM_API_KEY to the key of the judge you run.
LITELLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Training logs to Weights & Biases (train/utils.py, report_to="wandb"). Use WANDB_MODE=offline to skip the account.
WANDB_API_KEY=
